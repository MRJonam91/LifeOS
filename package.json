{
  "name": "lifeos",
  "version": "1.0.0",
  "description": "Local-first personal operating system: track documents, deadlines, warranties, paperwork procedures, and export calendar feeds. Privacy-first, zero cloud dependencies.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Manoj Rollo <fbxmano@gmail.com> (https://github.com/MRJonam91)",
  "homepage": "https://github.com/MRJonam91/LifeOS#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MRJonam91/LifeOS.git"
  },
  "bugs": {
    "url": "https://github.com/MRJonam91/LifeOS/issues"
  },
  "keywords": [
    "lifeos",
    "personal-dashboard",
    "deadline-tracker",
    "document-vault",
    "warranty-tracker",
    "paperwork",
    "pratiche",
    "ical",
    "local-first",
    "privacy-first",
    "typescript",
    "nodejs",
    "cli",
    "digital-binder",
    "life-admin"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "lifeos": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.it.md",
    "LICENSE",
    "COMMERCIAL-LICENSE.md",
    "CLA.md",
    "LICENSING.md"
  ],
  "scripts": {
    "start": "node --loader ts-node/esm src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/MRJonam91"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/mrjonam"
    },
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/mrjonam"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/manorollo"
    }
  ],
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.7.3"
  }
}
